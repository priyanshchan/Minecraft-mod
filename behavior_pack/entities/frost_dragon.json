{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "overlord:frost_dragon",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "overlord:mode_switcher": {
        "minecraft:target_nearby_sensor": {
          "inside_range": 4.5,
          "outside_range": 6.5,
          "must_see": true,
          "on_inside_range": {
            "event": "overlord:switch_to_melee",
            "target": "self"
          },
          "on_outside_range": {
            "event": "overlord:switch_to_ranged",
            "target": "self"
          }
        }
      },
      "overlord:ranged_mode": {
        "minecraft:shooter": {
          "def": "overlord:frost_breath"
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 3,
          "burst_shots": 3,
          "burst_interval": 0.25,
          "attack_interval_min": 2.5,
          "attack_interval_max": 4.0,
          "attack_radius": 26.0,
          "speed_multiplier": 1.0
        }
      },
      "overlord:melee_mode": {
        "minecraft:attack": {
          "damage": 18,
          "effect_name": "slowness",
          "effect_duration": 4
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 3,
          "speed_multiplier": 1.2,
          "track_target": true
        }
      },
      "overlord:airborne": {
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true
        },
        "minecraft:movement": {
          "value": 0.0
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "frost_dragon",
