        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": false
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/overlord/frost_dragon.json"
      },
      "minecraft:scale": {
        "value": 2.6
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:persistent": {},
      "minecraft:boss": {
        "hud_range": 55,
        "should_darken_sky": false
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "freezing",
            "deals_damage": false
          }
        ]
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 48
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "nazarick_ally"
            },
            "max_dist": 48
          }
        ]
      },
      "minecraft:variable_max_auto_step": {
        "base_value": 2.0625,
        "controlled_value": 2.0625,
        "jump_prevented_value": 1.0625
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "overlord:mode_switcher",
            "overlord:ranged_mode"
          ]
        }
      },
      "overlord:switch_to_melee": {
        "remove": {
          "component_groups": [
            "overlord:ranged_mode"
          ]
        },
        "add": {
          "component_groups": [
            "overlord:melee_mode"
          ]
        }
      },
      "overlord:switch_to_ranged": {
        "remove": {
          "component_groups": [
            "overlord:melee_mode"
          ]
        },
        "add": {
          "component_groups": [
            "overlord:ranged_mode"
          ]
        }
      },
      "overlord:take_off": {
        "add": {
          "component_groups": [
            "overlord:airborne"
          ]
        }
      },
      "overlord:land": {
        "remove": {
          "component_groups": [
            "overlord:airborne"
          ]
        }
      }
    }
