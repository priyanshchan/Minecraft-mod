        "height": 2.0
      },
      "minecraft:health": {
        "value": 700,
        "max": 700
      },
      "minecraft:movement": {
        "value": 0.26
      },
      "minecraft:follow_range": {
        "value": 48,
        "max": 48
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 600 : 0"
      },
      "minecraft:nameable": {},
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },
