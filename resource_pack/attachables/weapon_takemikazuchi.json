{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "overlord:takemikazuchi.held",
      "item": {
        "overlord:takemikazuchi": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/weapons/takemikazuchi",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.overlord.weapon_takemikazuchi"
      },
      "animations": {
        "hold_first_person": "animation.overlord.weapon.blade.first_person",
        "hold_third_person": "animation.overlord.weapon.blade.third_person",
        "aura": "animation.overlord.weapon.aura"
      },
      "scripts": {
        "animate": [
          {
            "hold_first_person": "c.is_first_person"
          },
          {
            "hold_third_person": "!c.is_first_person"
          },
          {
            "aura": "!c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ],
      "particle_effects": {
        "aura": "overlord:weapon_aura_lightning"
      }
    }
  }
}
