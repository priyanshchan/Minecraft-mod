{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "overlord:dragonbone_blade.held",
      "item": {
        "overlord:dragonbone_blade": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/weapons/dragonbone_blade",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.overlord.weapon_dragonbone_blade"
      },
      "animations": {
        "hold_first_person": "animation.overlord.weapon.greatsword.first_person",
        "hold_third_person": "animation.overlord.weapon.greatsword.third_person"
      },
      "scripts": {
        "animate": [
          {
            "hold_first_person": "c.is_first_person"
          },
          {
            "hold_third_person": "!c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
