{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "overlord:vestment_boots.player",
      "item": {
        "overlord:vestment_boots": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/armor3d/vestment_boots",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.overlord.armor_vestment_boots"
      },
      "animations": {
        "first_person": "animation.overlord.armor.first_person"
      },
      "scripts": {
        "parent_setup": "variable.boot_layer_visible = 0.0;",
        "animate": [
          {
            "first_person": "c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
