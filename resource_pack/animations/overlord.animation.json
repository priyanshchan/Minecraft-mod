{
  "format_version": "1.8.0",
  "animations": {
    "animation.overlord.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0.0
          ]
        }
      }
    },
    "animation.overlord.idle": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "math.sin(query.life_time * 76.8) * 2.5",
            0.0,
            "math.cos(query.life_time * 103.2) * 2.5 + 2.5"
          ]
        },
        "leftArm": {
          "rotation": [
            "-math.sin(query.life_time * 76.8) * 2.5",
            0.0,
            "-(math.cos(query.life_time * 103.2) * 2.5 + 2.5)"
          ]
        }
      }
    },
    "animation.overlord.walk": {
      "loop": true,
      "bones": {
        "rightLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 45.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "leftLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180.0) * 45.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "rightArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180.0) * 25.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 25.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.overlord.robe_walk": {
      "loop": true,
      "bones": {
        "robe": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 4.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "rightArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180.0) * 12.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 12.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.overlord.attack": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            0.0,
            "math.sin(variable.attack_time * 180.0) * 8.0",
            0.0
          ]
        },
        "rightArm": {
          "rotation": [
            "-math.sin(variable.attack_time * 180.0) * 105.0",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.overlord.cast": {
      "loop": true,
      "bones": {
        "leftArm": {
          "rotation": [
            "query.is_casting ? (-150.0 + math.sin(query.life_time * 720.0) * 8.0) : 0.0",
            0.0,
            "query.is_casting ? -15.0 : 0.0"
          ]
        }
      }
    },
    "animation.overlord.wings": {
      "loop": true,
