    "animation.overlord.hamsuke.tail": {
      "loop": true,
      "bones": {
        "tail": {
          "rotation": [
            0.0,
            "math.sin(query.life_time * 100.0) * 10.0",
            0.0
          ]
        },
        "tail2": {
          "rotation": [
            0.0,
            "math.sin(query.life_time * 100.0 - 60.0) * 14.0",
            0.0
          ]
        },
        "tail3": {
          "rotation": [
            0.0,
