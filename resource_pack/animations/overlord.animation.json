          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180.0) * 40.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "leg2": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180.0) * 40.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        },
        "leg3": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 40.0 * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            0.0
          ]
        }
      }
