{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:beam_core",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/streak"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 * variable.scale * (1.0 + (variable.particle_age / variable.particle_lifetime))",
          "variable.length * 0.5"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.direction.x",
            "variable.direction.y",
            "variable.direction.z"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, variable.color.r, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.g, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.b, (variable.particle_age / variable.particle_lifetime))",
          "(1.0 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
}
