{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:orbit",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/star"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.2
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(variable.particle_age * 300.0 + variable.particle_random_1 * 360.0) * variable.scale",
          "0.2 + variable.particle_age * 1.3 + variable.particle_random_2 * 0.8",
          "math.sin(variable.particle_age * 300.0 + variable.particle_random_1 * 360.0) * variable.scale"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 * math.clamp(math.min(variable.particle_age * 6.0, (variable.particle_lifetime - variable.particle_age) * 3.0), 0.0, 1.0)",
          "0.12 * math.clamp(math.min(variable.particle_age * 6.0, (variable.particle_lifetime - variable.particle_age) * 3.0), 0.0, 1.0)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, variable.color.r, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.g, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.b, (variable.particle_age / variable.particle_lifetime))",
          "math.clamp(math.min(variable.particle_age * 6.0, (variable.particle_lifetime - variable.particle_age) * 3.0), 0.0, 1.0)"
        ]
      }
    }
  }
}
