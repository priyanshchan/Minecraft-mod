{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:nova",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/streak"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 46
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.6)"
      },
      "minecraft:particle_initial_speed": "math.random(2.2, 3.8) * variable.scale",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1",
          "0.8 * (1.0 - (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, variable.color.r, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.g, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.b, (variable.particle_age / variable.particle_lifetime))",
          1.0
        ]
      }
    }
  }
}
