{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:implode",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/star"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 26
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.scale",
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.5
      },
      "minecraft:particle_initial_speed": "variable.scale * 1.9",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + 0.12 * (variable.particle_age / variable.particle_lifetime)",
          "0.1 + 0.12 * (variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(variable.color.r, 1.0, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(variable.color.g, 1.0, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(variable.color.b, 1.0, (variable.particle_age / variable.particle_lifetime))",
          "math.clamp(math.min(variable.particle_age * 6.0, (variable.particle_lifetime - variable.particle_age) * 3.0), 0.0, 1.0)"
        ]
      }
    }
  }
}
