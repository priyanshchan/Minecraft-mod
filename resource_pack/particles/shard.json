        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, variable.color.r, 0.6)",
          "math.lerp(1.0, variable.color.g, 0.6)",
          "math.lerp(1.0, variable.color.b, 0.6)",
