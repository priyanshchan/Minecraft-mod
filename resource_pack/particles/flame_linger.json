{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:flame_linger",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/flame"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.2
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 14,
        "max_particles": 30
      },
      "minecraft:emitter_shape_disc": {
        "radius": "variable.scale",
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.4, 0.7)"
      },
      "minecraft:particle_initial_speed": "math.random(0.6, 1.6)",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.34 * (1.0 - 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "0.34 * (1.0 - 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 10,
            "max_frame": 4,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, variable.color.r, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.g, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.b, (variable.particle_age / variable.particle_lifetime))",
          "math.min(1.0, 2.5 * (1.0 - (variable.particle_age / variable.particle_lifetime)))"
        ]
      }
    }
  }
}
