{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/glow"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5 * variable.scale",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9, 1.8)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.2,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.07,
          0.07
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, variable.color.r, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.g, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(1.0, variable.color.b, (variable.particle_age / variable.particle_lifetime))",
          "(0.65 + 0.35 * math.sin(variable.particle_age * 1400.0 + variable.particle_random_1 * 360.0)) * (1.0 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
