{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "overlord:magic_circle",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/overlord/magic_circle"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 60
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.scale * (0.85 + 0.15 * math.min(1.0, variable.particle_age * 5.0))",
          "variable.scale * (0.85 + 0.15 * math.min(1.0, variable.particle_age * 5.0))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "math.clamp(math.min(variable.particle_age * 6.0, (variable.particle_lifetime - variable.particle_age) * 3.0), 0.0, 1.0)"
        ]
      }
    }
  }
}
